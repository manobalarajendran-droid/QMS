# Optional. Base URL of the companion API server.
#
# Leave this unset for a plain Cloudflare Pages deployment. The dashboard,
# registers, charts and reports all run in the browser and store their data
# locally, so they work with no server at all.
#
# Set it only if you also run the backend, which powers the few extra screens
# that need one: Scheduled Reports, Submissions, Quizzes, Global Search and
# Impact Analysis.
# VITE_API_URL=https://api.example.com

# Optional. Which Supabase project the app signs in to and syncs with.
#
# The app already has a project baked in, so a plain build works without these.
# Set them to point a deployment at a different Supabase project - for example
# a test project separate from the live one.
#
# Both of these are public by design and ship inside the JavaScript bundle.
# Row level security in the database is what protects the data. The
# service_role key is a different thing and must never be put here.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Whether anyone has to sign in.
# Signing in is OFF unless this says exactly "true". With it off, whoever opens
# the site is an admin and the records stay in that browser. Turn it on before
# real quality records go in - the site is on the open internet.
# VITE_REQUIRE_LOGIN=true
